{
  "name": "@depo-ui/react",
  "version": "0.2.0",
  "description": "Stable React entrypoint for Depo UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seipass/depo-ui.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/seipass/depo-ui#readme",
  "bugs": {
    "url": "https://github.com/seipass/depo-ui/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/css/index.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../tooling/package-build/clean-dist.mjs && tsc -p tsconfig.build.json && node ../../tooling/react-build/copy-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "cd ../.. && vitest run --config vitest.workspace.ts --passWithNoTests"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./css": {
      "types": "./dist/css/index.d.ts",
      "default": "./dist/css/index.css"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@depo-ui/components": "workspace:*",
    "@depo-ui/patterns": "workspace:*",
    "@depo-ui/foundations": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.0.0 <20.0.0",
    "react-dom": ">=19.0.0 <20.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:"
  }
}
