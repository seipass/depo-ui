{
  "name": "@depo-ui/react",
  "version": "0.0.0",
  "private": true,
  "description": "Stable React entrypoint for Depo UI",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "cd ../.. && vitest run --config vitest.workspace.ts --passWithNoTests"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@depo-ui/components": "workspace:*",
    "@depo-ui/patterns": "workspace:*",
    "@depo-ui/foundations": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.0.0 <20.0.0",
    "react-dom": ">=19.0.0 <20.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:"
  }
}
