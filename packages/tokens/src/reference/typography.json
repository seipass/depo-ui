{
  "font": {
    "family": {
      "ui": {
        "$type": "fontFamily",
        "$value": ["Inter", "Noto Sans JP", "Noto Sans", "Segoe UI", "system-ui", "sans-serif"],
        "$description": "UI family with CJK and system fallbacks",
        "$extensions": { "depo-ui": { "tier": "reference", "status": "stable" } }
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Cascadia Code",
          "Roboto Mono",
          "Menlo",
          "monospace"
        ],
        "$description": "Code and keyboard family",
        "$extensions": { "depo-ui": { "tier": "reference", "status": "stable" } }
      }
    },
    "size": {
      "100": {
        "$type": "dimension",
        "$value": { "value": 12, "unit": "px" },
        "$description": "Small supporting text",
        "$extensions": { "depo-ui": { "tier": "reference", "status": "stable" } }
      },
      "200": {
        "$type": "dimension",
        "$value": { "value": 14, "unit": "px" },
        "$description": "Body small",
        "$extensions": { "depo-ui": { "tier": "reference", "status": "stable" } }
      },
      "300": {
        "$type": "dimension",
        "$value": { "value": 16, "unit": "px" },
        "$description": "Body default",
        "$extensions": { "depo-ui": { "tier": "reference", "status": "stable" } }
      },
      "400": {
        "$type": "dimension",
        "$value": { "value": 18, "unit": "px" },
        "$description": "Body large",
        "$extensions": { "depo-ui": { "tier": "reference", "status": "stable" } }
      },
      "500": {
        "$type": "dimension",
        "$value": { "value": 20, "unit": "px" },
        "$description": "Heading small",
        "$extensions": { "depo-ui": { "tier": "reference", "status": "stable" } }
      },
      "600": {
        "$type": "dimension",
        "$value": { "value": 24, "unit": "px" },
        "$description": "Heading medium",
        "$extensions": { "depo-ui": { "tier": "reference", "status": "stable" } }
      },
      "700": {
        "$type": "dimension",
        "$value": { "value": 28, "unit": "px" },
        "$description": "Heading large",
        "$extensions": { "depo-ui": { "tier": "reference", "status": "stable" } }
      },
      "800": {
        "$type": "dimension",
        "$value": { "value": 32, "unit": "px" },
        "$description": "Display small",
        "$extensions": { "depo-ui": { "tier": "reference", "status": "stable" } }
      },
      "900": {
        "$type": "dimension",
        "$value": { "value": 40, "unit": "px" },
        "$description": "Display large",
        "$extensions": { "depo-ui": { "tier": "reference", "status": "stable" } }
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400,
        "$description": "Regular text weight",
        "$extensions": { "depo-ui": { "tier": "reference", "status": "stable" } }
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500,
        "$description": "Medium control and label weight",
        "$extensions": { "depo-ui": { "tier": "reference", "status": "stable" } }
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600,
        "$description": "Semibold emphasis weight",
        "$extensions": { "depo-ui": { "tier": "reference", "status": "stable" } }
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700,
        "$description": "Bold display weight",
        "$extensions": { "depo-ui": { "tier": "reference", "status": "stable" } }
      }
    },
    "lineHeight": {
      "tight": {
        "$type": "number",
        "$value": 1.2,
        "$description": "Display line height",
        "$extensions": { "depo-ui": { "tier": "reference", "status": "stable" } }
      },
      "normal": {
        "$type": "number",
        "$value": 1.5,
        "$description": "Body line height",
        "$extensions": { "depo-ui": { "tier": "reference", "status": "stable" } }
      },
      "loose": {
        "$type": "number",
        "$value": 1.7,
        "$description": "Long-form and CJK line height",
        "$extensions": { "depo-ui": { "tier": "reference", "status": "stable" } }
      }
    },
    "letterSpacing": {
      "normal": {
        "$type": "dimension",
        "$value": { "value": 0, "unit": "px" },
        "$description": "Default tracking",
        "$extensions": { "depo-ui": { "tier": "reference", "status": "stable" } }
      },
      "wide": {
        "$type": "dimension",
        "$value": { "value": 0.2, "unit": "px" },
        "$description": "Small text tracking adjustment",
        "$extensions": { "depo-ui": { "tier": "reference", "status": "stable" } }
      }
    }
  }
}
