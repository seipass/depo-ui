{
  "elevation": {
    "base": {
      "$type": "shadow",
      "$value": {
        "color": "#00000066",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 0, "unit": "px" },
        "blur": { "value": 0, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      },
      "$description": "Base elevation; mostly surface contrast",
      "$extensions": { "depo-ui": { "tier": "reference", "status": "stable" } }
    },
    "raised": {
      "$type": "shadow",
      "$value": {
        "color": "#00000040",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 2, "unit": "px" },
        "blur": { "value": 8, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      },
      "$description": "Raised card elevation",
      "$extensions": { "depo-ui": { "tier": "reference", "status": "stable" } }
    },
    "floating": {
      "$type": "shadow",
      "$value": {
        "color": "#00000055",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 4, "unit": "px" },
        "blur": { "value": 12, "unit": "px" },
        "spread": { "value": -2, "unit": "px" }
      },
      "$description": "Floating surface elevation",
      "$extensions": { "depo-ui": { "tier": "reference", "status": "stable" } }
    },
    "popover": {
      "$type": "shadow",
      "$value": {
        "color": "#00000066",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 6, "unit": "px" },
        "blur": { "value": 14, "unit": "px" },
        "spread": { "value": -3, "unit": "px" }
      },
      "$description": "Popover elevation",
      "$extensions": { "depo-ui": { "tier": "reference", "status": "stable" } }
    },
    "modal": {
      "$type": "shadow",
      "$value": {
        "color": "#00000088",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 8, "unit": "px" },
        "blur": { "value": 14, "unit": "px" },
        "spread": { "value": -4, "unit": "px" }
      },
      "$description": "Modal elevation",
      "$extensions": { "depo-ui": { "tier": "reference", "status": "stable" } }
    }
  }
}
