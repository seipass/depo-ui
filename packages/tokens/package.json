{
  "name": "@depo-ui/tokens",
  "version": "0.1.2",
  "description": "Token source and generated token boundary",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seipass/depo-ui.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/seipass/depo-ui#readme",
  "bugs": {
    "url": "https://github.com/seipass/depo-ui/issues"
  },
  "type": "module",
  "files": [
    "generated",
    "README.md",
    "LICENSE"
  ],
  "main": "./generated/tokens.js",
  "types": "./generated/tokens.d.ts",
  "sideEffects": [
    "./generated/tokens.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../tooling/token-build/build.mjs",
    "typecheck": "node ../../tooling/token-lint/check.mjs",
    "lint": "node ../../tooling/token-lint/check.mjs",
    "test": "node ../../tooling/token-lint/check.mjs"
  },
  "exports": {
    ".": {
      "types": "./generated/tokens.d.ts",
      "import": "./generated/tokens.js",
      "default": "./generated/tokens.js"
    },
    "./css": "./generated/tokens.css",
    "./manifest.json": "./generated/manifest.json",
    "./package.json": "./package.json"
  }
}
