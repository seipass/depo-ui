{
  "name": "@depo-ui/utilities",
  "version": "0.2.0",
  "description": "Small UI-independent utilities",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seipass/depo-ui.git",
    "directory": "packages/utilities"
  },
  "homepage": "https://github.com/seipass/depo-ui#readme",
  "bugs": {
    "url": "https://github.com/seipass/depo-ui/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../tooling/package-build/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "cd ../.. && vitest run --config vitest.workspace.ts --passWithNoTests"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=19.0.0 <20.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:"
  }
}
