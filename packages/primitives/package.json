{
  "name": "@depo-ui/primitives",
  "version": "0.0.0",
  "private": true,
  "description": "Small layout and DOM primitives",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../tooling/primitives-build/copy-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "cd ../.. && vitest run --config vitest.workspace.ts --passWithNoTests"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./css": "./dist/css/index.css",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@depo-ui/foundations": "workspace:*",
    "@depo-ui/accessibility": "workspace:*",
    "@depo-ui/utilities": "workspace:*",
    "@depo-ui/icons": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.0.0 <20.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:"
  }
}
