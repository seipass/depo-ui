{
  "name": "@depo-ui/foundations",
  "version": "0.0.0",
  "private": true,
  "description": "Foundation CSS and layout boundary",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../tooling/foundation-build/copy-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "cd ../.. && vitest run --config vitest.workspace.ts --passWithNoTests"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./css": "./dist/css/index.css",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@depo-ui/tokens": "workspace:*"
  }
}
