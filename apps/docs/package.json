{
  "name": "@depo-ui/docs",
  "version": "0.0.0",
  "private": true,
  "description": "Depo UI documentation site boundary",
  "scripts": {
    "start": "node ../../tooling/docs-generator/generate.mjs && docusaurus start",
    "build": "node ../../tooling/docs-generator/generate.mjs && docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src docusaurus.config.mjs sidebars.mjs",
    "test": "node ../../tooling/docs-generator/check.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@depo-ui/foundations": "workspace:*",
    "@depo-ui/react": "workspace:*",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "typescript": "catalog:"
  }
}
