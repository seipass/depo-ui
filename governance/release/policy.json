{
  "$schema": "../../specs/_schemas/release-policy.schema.json",
  "schemaVersion": 1,
  "versioning": "semver",
  "baseBranch": "master",
  "registry": "https://registry.npmjs.org",
  "changesets": {
    "config": ".changeset/config.json",
    "requiredFor": ["package-source", "public-api", "breaking-change", "deprecation"],
    "optionalFor": ["documentation-only", "governance-only", "test-only"]
  },
  "publish": {
    "requiresApprovedEnvironment": true,
    "approvalEnvironment": "release",
    "requiresToken": false,
    "tokenVariables": ["NODE_AUTH_TOKEN", "NPM_TOKEN"],
    "publicPackages": [
      "@depo-ui/accessibility",
      "@depo-ui/components",
      "@depo-ui/foundations",
      "@depo-ui/icons",
      "@depo-ui/patterns",
      "@depo-ui/primitives",
      "@depo-ui/react",
      "@depo-ui/tokens",
      "@depo-ui/utilities"
    ],
    "authentication": {
      "trustedPublishing": "github-actions-oidc",
      "bootstrapToken": "granular-access-token",
      "requiresGitHubActionsRuntime": true
    },
    "provenance": "required",
    "rejectPrivatePackages": true,
    "command": "pnpm release:publish"
  },
  "rollback": {
    "preferredAction": "forward-fix",
    "packageUnpublish": "forbidden",
    "steps": [
      "stop the release workflow and record the incident",
      "restore the previous known-good application lockfile or package version",
      "publish a patch or revert release when registry policy allows",
      "keep the migration and deprecation evidence linked to the incident"
    ]
  }
}
